#%%
# ============================================================
# Repeated-Sales TOM (prep pairs for Stata)
# Output:
#   tom_repeat_pairs.dta with: pid zipnum t0 t1 dy gap
#   tom_repeat_meta.dta  with: T base_tm start_year
# ============================================================

import os
import pandas as pd
import numpy as np

# -----------------------------
# Settings
# -----------------------------
dta_file   = "/project/cl/work_folder/mls_hmda_lu/data/mls/MLS_panel_hedonic_TOM_2011_2022.dta" // Input the dataset with unadjusted days on market
out_dir    = "/project/cl/work_folder/mls_hmda_lu/data/YT"
base_year  = 2015
base_month = 1

os.makedirs(out_dir, exist_ok=True)

if not os.path.exists(dta_file):
    raise FileNotFoundError(f"Input .dta not found: {dta_file}")

# -----------------------------
# Read only required variables
# -----------------------------
usecols = [
    "TOM_days",
    "CLIP",           # property id
    "year",
    "month",
    "LISTING_DATE",
    "OFF_MARKET_DATE",
    "ZIP"
]
df = pd.read_stata(dta_file, columns=usecols)


#%%
# -----------------------------
# Clean / types
# -----------------------------
df = df.dropna(subset=["TOM_days", "CLIP", "year", "month"])
df = df[df["TOM_days"] >= 0].copy()

# enforce int year/month if they come in float
df["year"] = df["year"].astype(int)
df["month"] = df["month"].astype(int)

# log transform
df["log_tom"] = np.log1p(df["TOM_days"].astype(float))

# Build tm relative to sample start year
start_year = int(df["year"].min())
df["tm"] = (df["year"] - start_year) * 12 + (df["month"] - 1)
df["tm"] = df["tm"].astype(int)

# ZIP cleaning: keep first 5 digits, preserve leading zeros
# Output zipnum as string "#####"
zip_raw = df["ZIP"].astype("string").str.strip()
df["zipnum"] = zip_raw.str.extract(r"(\d{5})", expand=False)

# Drop observations with missing zip if you need zipnum downstream
df = df.dropna(subset=["zipnum"]).copy()

# (Optional) If you prefer numeric zipnum in Stata (no leading zeros):
# df["zipnum"] = df["zipnum"].astype(int)

# Sort by property and time
df = df.sort_values(["CLIP", "tm"]).reset_index(drop=True)

# -----------------------------
# Construct repeat-sale pairs (adjacent transactions)
# ZIP-month is defined by t1 -> take zipnum from later observation
# -----------------------------
pairs_list = []

for pid, g in df.groupby("CLIP", sort=False):
    if len(g) < 2:
        continue

    g = g.sort_values("tm")

    # adjacent pairs
    for j in range(len(g) - 1):
        s0 = g.iloc[j]
        s1 = g.iloc[j + 1]

        t0 = int(s0["tm"])
        t1 = int(s1["tm"])
        gap = t1 - t0
        if gap <= 0:
            continue

        pairs_list.append({
            "pid": pid,
            "zipnum": s1["zipnum"],                 # ZIP at t1 (later month)
            "t0": t0,
            "t1": t1,
            "dy": float(s1["log_tom"] - s0["log_tom"]),
            "gap": int(gap),
        })

pairs = pd.DataFrame(pairs_list)

if pairs.empty:
    raise ValueError("No repeat-sale pairs constructed. Check CLIP coverage and filtering.")

# Drop very long gaps (renovation / regime changes proxy)
pairs = pairs[pairs["gap"] <= 120].copy()  # <= 10 years

# Ensure clean dtypes for Stata
pairs["t0"] = pairs["t0"].astype(int)
pairs["t1"] = pairs["t1"].astype(int)
pairs["gap"] = pairs["gap"].astype(int)
pairs["dy"] = pairs["dy"].astype(float)

# Compute base_tm relative to start_year
base_tm = int((base_year - start_year) * 12 + (base_month - 1))
T = int(df["tm"].max() + 1)

# sanity check
if not (0 <= base_tm < T):
    raise ValueError(f"base_tm out of range: base_tm={base_tm}, T={T}. "
                     f"Check base_year/base_month vs sample start_year={start_year}.")

#%%
# -----------------------------
# Write outputs for Stata
# -----------------------------
out_pairs = pairs[["pid", "zipnum", "t0", "t1", "dy", "gap"]].copy()

meta = pd.DataFrame({
    "T": [T],
    "base_tm": [base_tm],
    "start_year": [start_year]
})

pairs_path = os.path.join(out_dir, "tom_repeat_pairs.dta")
meta_path  = os.path.join(out_dir, "tom_repeat_meta.dta")

out_pairs.to_stata(pairs_path, write_index=False)
meta.to_stata(meta_path, write_index=False)

print("Wrote:", pairs_path)
print("Wrote:", meta_path)
print("Pairs:", len(out_pairs), "| Unique pid:", out_pairs["pid"].nunique(), "| Unique t1:", out_pairs["t1"].nunique())

# ============================================================
# ZIP-specific repeated-sales TOM index (Python)
# Input:  tom_repeat_pairs.dta with pid zipnum t0 t1 dy gap
#         tom_repeat_meta.dta  with T base_tm start_year
# Output: zip_month_tom_index_python.dta / .csv
#         Columns: zipnum tm year month delta tom_index n_pairs rank_x
# ============================================================

import os
import numpy as np
import pandas as pd
import statsmodels.api as sm

pairs_path = "/project/cl/work_folder/mls_hmda_lu/data/YT/tom_repeat_pairs.dta"
meta_path  = "/project/cl/work_folder/mls_hmda_lu/data/YT/tom_repeat_meta.dta"
out_dir    = "/project/cl/work_folder/mls_hmda_lu/data/YT"
os.makedirs(out_dir, exist_ok=True)

pairs = pd.read_stata(pairs_path)
meta  = pd.read_stata(meta_path)

T          = int(meta.loc[0, "T"])
base_tm    = int(meta.loc[0, "base_tm"])
start_year = int(meta.loc[0, "start_year"])

# -----------------------------
# Clean
# -----------------------------
pairs = pairs.dropna(subset=["pid", "zipnum", "t0", "t1", "dy", "gap"]).copy()
pairs["t0"]  = pairs["t0"].astype(int)
pairs["t1"]  = pairs["t1"].astype(int)
pairs["gap"] = pairs["gap"].astype(int)
pairs["dy"]  = pairs["dy"].astype(float)

pairs = pairs[(pairs["t0"] >= 0) & (pairs["t1"] >= 0) & (pairs["t0"] < T) & (pairs["t1"] < T)].copy()
pairs = pairs[pairs["gap"] > 0].copy()

if len(pairs) == 0:
    raise ValueError("No valid pairs after cleaning.")

# tm columns in the regression (drop base)
col_tms = [k for k in range(T) if k != base_tm]
k_map = {tm: j for j, tm in enumerate(col_tms)}  # tm -> column index
K = T - 1

# Minimum pairs threshold (tune as you like)
MIN_PAIRS = 50

rows_out = []

for zipnum, g in pairs.groupby("zipnum", sort=False):
    n = len(g)
    if n < MIN_PAIRS:
        continue

    t0 = g["t0"].to_numpy()
    t1 = g["t1"].to_numpy()
    y  = g["dy"].to_numpy(dtype=float)

    # Build Xz
    Xz = np.zeros((n, K), dtype=np.int8)
    for r in range(n):
        if t1[r] != base_tm:
            Xz[r, k_map[t1[r]]] = 1
        if t0[r] != base_tm:
            Xz[r, k_map[t0[r]]] = -1

    # Check rank to avoid singular systems (common in small zips)
    rank_x = np.linalg.matrix_rank(Xz)
    if rank_x < 5:   # very low variation -> skip
        continue

    # -----------------------------
    # First-stage OLS -> residuals
    # -----------------------------
    beta_ols = np.linalg.lstsq(Xz, y, rcond=None)[0]
    resid = y - Xz @ beta_ols
    resid2 = resid**2

    # -----------------------------
    # Variance model within ZIP: Var(e|gap) = a + b*gap + c*gap^2
    # -----------------------------
    gap = g["gap"].to_numpy(dtype=float)
    Z = np.column_stack([np.ones_like(gap), gap, gap**2])

    # if Z is rank-deficient (e.g., constant gap), fall back to linear
    if np.linalg.matrix_rank(Z) < 3:
        Z = np.column_stack([np.ones_like(gap), gap])

    var_fit = sm.OLS(resid2, Z).fit()
    sig2hat = var_fit.predict(Z)

    # guard against nonpositive variance
    sig2hat = np.where(sig2hat <= 0, np.nan, sig2hat)
    mask = ~np.isnan(sig2hat)

    # If too many invalid, skip
    if mask.sum() < max(20, int(0.5 * n)):
        continue

    X2 = Xz[mask]
    y2 = y[mask]
    w  = 1.0 / sig2hat[mask]
    W  = np.sqrt(w)

    # -----------------------------
    # WLS / FGLS for zip-specific delta
    # -----------------------------
    beta_wls = np.linalg.lstsq(X2 * W[:, None], y2 * W, rcond=None)[0]

    delta = np.zeros(T, dtype=float)
    delta[base_tm] = 0.0
    for tm in col_tms:
        delta[tm] = beta_wls[k_map[tm]]

    tom_index = 100.0 * np.exp(delta)  # base=100 because delta_base=0

    # Store in long format: one row per zip-month
    for tm in range(T):
        rows_out.append({
            "zipnum": zipnum,
            "tm": int(tm),
            "year": int(start_year + tm // 12),
            "month": int((tm % 12) + 1),
            "delta": float(delta[tm]),
            "tom_index": float(tom_index[tm]),
            "n_pairs": int(n),
            "rank_x": int(rank_x),
        })

zip_month = pd.DataFrame(rows_out)

out_dta = os.path.join(out_dir, "zip_month_tom_index_python.dta")
out_csv = os.path.join(out_dir, "zip_month_tom_index_python.csv")

zip_month.to_stata(out_dta, write_index=False)
zip_month.to_csv(out_csv, index=False)

print("Wrote:", out_dta)
print("Wrote:", out_csv)
print("ZIPs kept:", zip_month["zipnum"].nunique() if not zip_month.empty else 0)
print("Rows:", len(zip_month))
